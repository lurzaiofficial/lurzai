# ---------------------------------------------------------------------------
# LURZ AI — configuration
#
# Signal advisor: analyses markets and scores setups. Never places orders and
# never asks end users for exchange credentials.
# ---------------------------------------------------------------------------

# HTTP port for the server.
PORT=3000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Where the JSON datastore is written. Defaults to ./.data
# DATA_DIR=./.data

# ---------------------------------------------------------------------------
# AI analysis  (REQUIRED for signals)
#
# The operator supplies this key. End users never provide one and can never
# see it. Without it the app still shows live prices and technical indicators,
# but signal generation is disabled — it will NOT invent a substitute signal.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""

# Sent to OpenRouter for attribution.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stocks, forex, commodities, indices and ETFs  (OPTIONAL)
#
# Twelve Data powers all non-crypto markets. Without this key those markets are
# simply excluded from search; crypto continues to work fully.
# Free tier: https://twelvedata.com/pricing
# ---------------------------------------------------------------------------
TWELVEDATA_API_KEY=""

# ---------------------------------------------------------------------------
# Crypto market data  (NO KEY REQUIRED)
#
# Binance, Coinbase, Kraken, Bybit and OKX are accessed through their public
# market-data endpoints only. No credentials exist anywhere in this codebase.
# ---------------------------------------------------------------------------

# Override the Binance REST host if it is blocked in your region.
# BINANCE_BASE_URL="https://api.binance.com"
