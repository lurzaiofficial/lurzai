# ---------------------------------------------------------------------------
# LURZ AI — configuration
#
# Signal advisor: analyses markets and scores setups. Never places orders and
# never asks end users for exchange credentials.
#
# Local: copy to `.env` and fill values.
# Vercel: set the same names under Project → Settings → Environment Variables
# (Production + Preview). Never commit a real `.env`.
# ---------------------------------------------------------------------------

# HTTP port for the local server (ignored on Vercel serverless).
PORT=3000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Where the JSON datastore is written. Defaults to ./.data
# Note: on Vercel the filesystem is ephemeral — prefer a durable store later.
# DATA_DIR=./.data

# ---------------------------------------------------------------------------
# AI analysis  (REQUIRED for signals)
#
# The operator supplies this key. End users never provide one and can never
# see it. Without it the app still shows live prices and technical indicators,
# but signal generation is disabled — it will NOT invent a substitute signal.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""

# Public site origin for Gemini API attribution and welcome-email links.
# Local default below. On Vercel set this to your production domain, e.g.
# APP_URL="https://lurzai.vercel.app"
# (If unset on Vercel, the server falls back to https://$VERCEL_URL.)
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stocks, forex, commodities, indices and ETFs  (OPTIONAL)
#
# Twelve Data powers all non-crypto markets. Without this key those markets are
# simply excluded from search; crypto continues to work fully.
# Free tier: https://twelvedata.com/pricing
# ---------------------------------------------------------------------------
TWELVEDATA_API_KEY=""

# ---------------------------------------------------------------------------
# Crypto market data  (NO KEY REQUIRED)
#
# Binance, Coinbase, Kraken, Bybit and OKX are accessed through their public
# market-data endpoints only. No credentials exist anywhere in this codebase.
# ---------------------------------------------------------------------------

# Override the Binance REST host if it is blocked in your region.
# Optional Binance overrides. Default REST host is data-api.binance.vision
# (works from US/Vercel); api.binance.com is often HTTP 451 from cloud IPs.
# BINANCE_BASE_URL="https://data-api.binance.vision"
# BINANCE_STREAM_URL="wss://data-stream.binance.vision"

# ---------------------------------------------------------------------------
# Supabase Auth  (REQUIRED for Sign in / Sign up)
#
# Create a project at https://supabase.com and paste the Project URL and anon
# (publishable) key. These VITE_* names are what Vite/Vercel inject into the
# browser bundle — use exactly these names in Vercel env settings.
#
# Dashboard tips:
# - Authentication → Providers → Email: enable Email provider
# - To allow sign-up → /app without confirming email first, turn OFF
#   "Confirm email" under Authentication → Providers → Email
# - Authentication → URL Configuration — allow both local and production:
#
#   Site URL (production):
#     https://lurzai.vercel.app
#
#   Redirect URLs (add all):
#     http://localhost:3000/**
#     http://localhost:3000/reset-password
#     http://localhost:3000/app
#     https://lurzai.vercel.app/**
#     https://lurzai.vercel.app/reset-password
#     https://lurzai.vercel.app/app
#     https://*-lurz-ai.vercel.app/**   (optional: Preview deployments)
#
# Auth redirects in the app use window.location.origin (no hardcoded host).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Resend  (OPTIONAL — app welcome emails + Supabase Auth SMTP)
#
# Server-side only. Never expose this key to the browser (no VITE_ prefix).
# Local: set in .env. Production: add the same name in Vercel → Project →
# Settings → Environment Variables (Production + Preview).
#
# Supabase Auth emails (confirm signup, forgot password) are NOT sent by this
# app. To deliver those through Resend, configure Custom SMTP in the Supabase
# dashboard (Authentication → SMTP Settings / Emails):
#   Host: smtp.resend.com
#   Port: 465 (SSL) or 587 (STARTTLS)
#   Username: resend
#   Password: <same RESEND_API_KEY value>
#   Sender email: a verified Resend domain address (or onboarding@resend.dev for tests)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# From address for app-owned transactional mail (welcome). Must match a verified
# Resend domain in production. Sandbox default can only reach your Resend account email.
RESEND_FROM="LURZ AI <onboarding@resend.dev>"
