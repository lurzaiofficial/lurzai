{
  "name": "lurz-ai",
  "private": true,
  "version": "0.1.0",
  "description": "LURZ AI — live multi-market AI desk for trade signals",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:paper": "tsx scripts/verify-paper-trading.ts"
  },
